{
  "name": "sflow-docs",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "prepare:versions": "node scripts/prepare-versioned-docs.js",
    "prepare:recipes": "node scripts/prepare-recipes.js",
    "prebuild:site": "npm run prepare:recipes",
    "prestart": "npm run prepare:recipes",
    "test": "node --test",
    "test:versions": "node --test scripts/prepare-versioned-docs.test.js",
    "build:site": "docusaurus build",
    "start": "npm run prepare:versions && docusaurus start --host 0.0.0.0 --port 3000",
    "build": "npm run prepare:versions && npm run build:site",
    "serve": "docusaurus serve --host 0.0.0.0 --port 3000",
    "clear": "docusaurus clear"
  },
  "dependencies": {
    "@cmfcmf/docusaurus-search-local": "^2.0.0",
    "@docusaurus/core": "^3.7.0",
    "@docusaurus/plugin-client-redirects": "^3.7.0",
    "@docusaurus/preset-classic": "^3.7.0",
    "@docusaurus/theme-mermaid": "^3.7.0",
    "@mdx-js/react": "^3.0.1",
    "js-yaml": "^4.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "overrides": {
    "tinypool": "^2.2.0",
    "postcss-selector-parser": "^7.1.6",
    "serialize-javascript": "^7.1.3",
    "qs": "^6.16.1",
    "sockjs": {
      "uuid": "^11.1.1"
    },
    "schema-utils": "^4.3.3"
  },
  "engines": {
    "node": ">=20.0"
  }
}
